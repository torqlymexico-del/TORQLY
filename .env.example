# App
APP_NAME=Torqly / El Garagillo
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=720
AUTH_COOKIE_NAME=torqly_access_token
TIMEZONE=America/Mexico_City
BASE_URL=http://127.0.0.1:8000
APP_PUBLIC_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/torqly_db
# Quick local smoke test alternative:
# DATABASE_URL=sqlite:///./torqly_local.db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=torqly_db

# Bootstrap admin
BOOTSTRAP_ADMIN_ON_STARTUP=true
DEFAULT_ADMIN_NAME=Administrador General
DEFAULT_ADMIN_PHONE=6140000000
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_SECRET=

# Legacy aliases still supported
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_WEBHOOK_SECRET=
META_WHATSAPP_API_VERSION=v20.0

# Google Calendar API
# Use either GOOGLE_SERVICE_ACCOUNT_FILE or the OAuth refresh-token fields below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
GOOGLE_CALENDAR_SEND_UPDATES=all
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_FILE=

# ClickUp API
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_SPACE_ID=
CLICKUP_FOLDER_ID=
CLICKUP_LIST_ID=
CLICKUP_WEBHOOK_SECRET=

# Scheduler
SCHEDULER_ENABLED=true
DAILY_CLOSE_TIME=20:00

# Privacy policy
PRIVACY_POLICY_VERSION=1.0

# Google Login (OAuth2 para iniciar sesión — usa las mismas credenciales de GOOGLE_CLIENT_ID/SECRET)
# APP_PUBLIC_URL debe apuntar a la URL pública donde corre el servidor para que el callback funcione.
GOOGLE_LOGIN_ENABLED=true
